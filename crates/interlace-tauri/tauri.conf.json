{
  "productName": "Interlace",
  "version": "0.1.0",
  "identifier": "app.interlace.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Interlace",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'none'; frame-src 'none'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "Interlace.entitlements",
      "minimumSystemVersion": "12.0"
    }
  }
}
