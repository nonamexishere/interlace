{
  "productName": "Interlace",
  "version": "0.1.2",
  "identifier": "app.interlace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Interlace",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: cas:; media-src 'self' cas: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://ipc.localhost; frame-src data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "Interlace.entitlements",
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
