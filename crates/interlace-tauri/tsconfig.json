{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "types": ["svelte"],
    "baseUrl": ".",
    "paths": {
      "$lib": ["web/lib"],
      "$lib/*": ["web/lib/*"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.svelte", "vite.config.ts"]
}
